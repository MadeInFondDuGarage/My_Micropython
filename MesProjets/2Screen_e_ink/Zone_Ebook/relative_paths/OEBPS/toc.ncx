    <navPoint id="navPoint-73" playOrder="73">
      <navLabel>
        <text>Árbol de Diana (1962)</text>
      </navLabel>
      <content src="Text/Section0075.xhtml" />
      <navPoint id="navPoint-74" playOrder="74">
        <navLabel>
          <text>Introducción de Octavio Paz</text>
        </navLabel>
        <content src="Text/Section0076.xhtml" />
      </navPoint>
      <navPoint id="navPoint-75" playOrder="75">
        <navLabel>
          <text>1 He dado el saldo deí al alba…</text>
        </navLabel>
        <content src="Text/Section0077.xhtml" />
      </navPoint>
      <navPoint id="navPoint-76" playOrder="76">
        <navLabel>
          <text>2 Éstas son las versiones que nos propone…</text>
        </navLabel>
        <content src="Text/Section0078.xhtml" />
      </navPoint>
      <navPoint id="navPoint-77" playOrder="77">
        <navLabel>
          <text>3 sólo la sed…</text>
        </navLabel>
        <content src="Text/Section0079.xhtml" />
      </navPoint>
      <navPoint id="navPoint-78" playOrder="78">
        <navLabel>
          <text>4 Quién dejará de hundir su mano…</text>
        </navLabel>
        <content src="Text/Section0080.xhtml" />
      </navPoint>
      <navPoint id="navPoint-79" playOrder="79">
        <navLabel>
          <text>5 por un minuto de vida breve…</text>
        </navLabel>
        <content src="Text/Section0081.xhtml" />
      </navPoint>
      <navPoint id="navPoint-80" playOrder="80">
        <navLabel>
          <text>6 ella se desnuda en el paraíso…</text>
        </navLabel>
        <content src="Text/Section0082.xhtml" />
      </navPoint>
      <navPoint id="navPoint-81" playOrder="81">
        <navLabel>
          <text>7 Salta con la camisa en llamas…</text>
        </navLabel>
        <content src="Text/Section0083.xhtml" />
      </navPoint>
      <navPoint id="navPoint-82" playOrder="82">
        <navLabel>
          <text>8 Memoria iluminada…</text>
        </navLabel>
        <content src="Text/Section0084.xhtml" />
      </navPoint>
      <navPoint id="navPoint-83" playOrder="83">
        <navLabel>
          <text>9 Estos huesos brillando en la noche…</text>
        </navLabel>
        <content src="Text/Section0085.xhtml" />
      </navPoint>
      <navPoint id="navPoint-84" playOrder="84">
        <navLabel>
          <text>10 un viento débil…</text>
        </navLabel>
        <content src="Text/Section0086.xhtml" />
      </navPoint>
      <navPoint id="navPoint-85" playOrder="85">
        <navLabel>
          <text>11 ahora…</text>
        </navLabel>
        <content src="Text/Section0087.xhtml" />
      </navPoint>
      <navPoint id="navPoint-86" playOrder="86">
        <navLabel>
          <text>12 no más las dulces metamorfosis…</text>
        </navLabel>
        <content src="Text/Section0088.xhtml" />
      </navPoint>
      <navPoint id="navPoint-87" playOrder="87">
        <navLabel>
          <text>13 explicar con palabras de este mundo…</text>
        </navLabel>
        <content src="Text/Section0089.xhtml" />
      </navPoint>
      <navPoint id="navPoint-88" playOrder="88">
        <navLabel>
          <text>14 El poema que no digo…</text>
        </navLabel>
        <content src="Text/Section0090.xhtml" />
      </navPoint>
      <navPoint id="navPoint-89" playOrder="89">
        <navLabel>
          <text>15 Extraño desacostumbrarme…</text>
        </navLabel>
        <content src="Text/Section0091.xhtml" />
      </navPoint>
      <navPoint id="navPoint-90" playOrder="90">
        <navLabel>
          <text>16 has construido tu casa…</text>
        </navLabel>
        <content src="Text/Section0092.xhtml" />
      </navPoint>
      <navPoint id="navPoint-91" playOrder="91">
        <navLabel>
          <text>17 Días en que una palabra lejana…</text>
        </navLabel>
        <content src="Text/Section0093.xhtml" />
      </navPoint>
      <navPoint id="navPoint-92" playOrder="92">
        <navLabel>
          <text>18 como un poema enterado…</text>
        </navLabel>
        <content src="Text/Section0094.xhtml" />
      </navPoint>
      <navPoint id="navPoint-93" playOrder="93">
        <navLabel>
          <text>19 cuando vea los ojos…</text>
        </navLabel>
        <content src="Text/Section0095.xhtml" />
      </navPoint>
      <navPoint id="navPoint-94" playOrder="94">
        <navLabel>
          <text>20 dice que no sabe del miedo…</text>
        </navLabel>
        <content src="Text/Section0096.xhtml" />
      </navPoint>
      <navPoint id="navPoint-95" playOrder="95">
        <navLabel>
          <text>21 he nacido tanto…</text>
        </navLabel>
        <content src="Text/Section0097.xhtml" />
      </navPoint>
      <navPoint id="navPoint-96" playOrder="96">
        <navLabel>
          <text>22 en la noche…</text>
        </navLabel>
        <content src="Text/Section0098.xhtml" />
      </navPoint>
      <navPoint id="navPoint-97" playOrder="97">
        <navLabel>
          <text>23 una mirada desde la alcantarilla…</text>
        </navLabel>
        <content src="Text/Section0099.xhtml" />
      </navPoint>
      <navPoint id="navPoint-98" playOrder="98">
        <navLabel>
          <text>24 estos hilos aprisionan a las sombras…</text>
        </navLabel>
        <content src="Text/Section0100.xhtml" />
      </navPoint>
      <navPoint id="navPoint-99" playOrder="99">
        <navLabel>
          <text>25 un agujero en la noche…</text>
        </navLabel>
        <content src="Text/Section0101.xhtml" />
      </navPoint>
      <navPoint id="navPoint-100" playOrder="100">
        <navLabel>
          <text>26 cuando el palacio de la noche…</text>
        </navLabel>
        <content src="Text/Section0102.xhtml" />
      </navPoint>
      <navPoint id="navPoint-101" playOrder="101">
        <navLabel>
          <text>27 un golpe del alba en las flores…</text>
        </navLabel>
        <content src="Text/Section0103.xhtml" />
      </navPoint>
      <navPoint id="navPoint-102" playOrder="102">
        <navLabel>
          <text>28 te alejas de los nombres…</text>
        </navLabel>
        <content src="Text/Section0104.xhtml" />
      </navPoint>
      <navPoint id="navPoint-103" playOrder="103">
        <navLabel>
          <text>29 Aquí vivimos con una mano en la garganta…</text>
        </navLabel>
        <content src="Text/Section0105.xhtml" />
      </navPoint>
      <navPoint id="navPoint-104" playOrder="104">
        <navLabel>
          <text>30 en el invierno fabuloso…</text>
        </navLabel>
        <content src="Text/Section0106.xhtml" />
      </navPoint>
      <navPoint id="navPoint-105" playOrder="105">
        <navLabel>
          <text>31 Es un cerrar los ojos…</text>
        </navLabel>
        <content src="Text/Section0107.xhtml" />
      </navPoint>
      <navPoint id="navPoint-106" playOrder="106">
        <navLabel>
          <text>32 Zona de plagas donde la dormida come…</text>
        </navLabel>
        <content src="Text/Section0108.xhtml" />
      </navPoint>
      <navPoint id="navPoint-107" playOrder="107">
        <navLabel>
          <text>33 alguna vez…</text>
        </navLabel>
        <content src="Text/Section0109.xhtml" />
      </navPoint>
      <navPoint id="navPoint-108" playOrder="108">
        <navLabel>
          <text>34 la pequeña viajera…</text>
        </navLabel>
        <content src="Text/Section0110.xhtml" />
      </navPoint>
      <navPoint id="navPoint-109" playOrder="109">
        <navLabel>
          <text>35 Vida, mi vida, déjate caer…</text>
        </navLabel>
        <content src="Text/Section0111.xhtml" />
      </navPoint>
      <navPoint id="navPoint-110" playOrder="110">
        <navLabel>
          <text>36 en la jaula del tiempo…</text>
        </navLabel>
        <content src="Text/Section0112.xhtml" />
      </navPoint>
      <navPoint id="navPoint-111" playOrder="111">
        <navLabel>
          <text>37 más allá de cualquier zona prohibida…</text>
        </navLabel>
        <content src="Text/Section0113.xhtml" />
      </navPoint>
      <navPoint id="navPoint-112" playOrder="112">
        <navLabel>
          <text>38 Este canto arrepentido…</text>
        </navLabel>
        <content src="Text/Section0114.xhtml" />
      </navPoint>
      <navPoint id="navPoint-113" playOrder="113">
        <navLabel>
          <text>Otros poemas (1959)</text>
        </navLabel>
        <content src="Text/Section0115.xhtml" />
        <navPoint id="navPoint-114" playOrder="114">
          <navLabel>
