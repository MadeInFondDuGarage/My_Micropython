      <navPoint id="navPoint-234" playOrder="234">
        <navLabel>
          <text>1956-1960</text>
        </navLabel>
        <content src="Text/Section0237.xhtml" />
        <navPoint id="navPoint-235" playOrder="235">
          <navLabel>
            <text>el silencio es luz…</text>
          </navLabel>
          <content src="Text/Section0238.xhtml" />
        </navPoint>
        <navPoint id="navPoint-236" playOrder="236">
          <navLabel>
            <text>Como dedos rodando premeditadamente…</text>
          </navLabel>
          <content src="Text/Section0239.xhtml" />
        </navPoint>
        <navPoint id="navPoint-237" playOrder="237">
          <navLabel>
            <text>aguardadora insomne…</text>
          </navLabel>
          <content src="Text/Section0240.xhtml" />
        </navPoint>
        <navPoint id="navPoint-238" playOrder="238">
          <navLabel>
            <text>Nocturno de Chopin por un pianista de cuatro años</text>
          </navLabel>
          <content src="Text/Section0241.xhtml" />
        </navPoint>
        <navPoint id="navPoint-239" playOrder="239">
          <navLabel>
            <text>Sin tierra común</text>
          </navLabel>
          <content src="Text/Section0242.xhtml" />
        </navPoint>
        <navPoint id="navPoint-240" playOrder="240">
          <navLabel>
            <text>Lamento</text>
          </navLabel>
          <content src="Text/Section0243.xhtml" />
        </navPoint>
        <navPoint id="navPoint-241" playOrder="241">
          <navLabel>
            <text>cuidado con las palabras…</text>
          </navLabel>
          <content src="Text/Section0244.xhtml" />
        </navPoint>
        <navPoint id="navPoint-242" playOrder="242">
          <navLabel>
            <text>los ojos…</text>
          </navLabel>
          <content src="Text/Section0245.xhtml" />
        </navPoint>
        <navPoint id="navPoint-243" playOrder="243">
