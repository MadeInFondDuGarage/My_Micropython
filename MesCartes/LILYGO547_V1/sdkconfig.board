
#
# --- BOOT / FLASH ---
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

#Les niveaux : 0=None, 1=Error, 2=Warning, 3=Info, 4=Debug, 5=Verbose.
# désactivation des log ESP
CONFIG_LOG_DEFAULT_LEVEL=5


CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

#
# --- Partition de la flash ---
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/LILYGO547_V1/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="boards/LILYGO547_V1/partitions.csv"

